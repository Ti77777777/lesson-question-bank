      "subquestions": [
        {
          "key": "1",
          "text": "求函数的单调区间。",
          "answer": "递增区间为 $(-\\infty,-1)$ 与 $(1,+\\infty)$，递减区间为 $(-1,1)$。"
        },
        {
          "key": "2",
          "text": "求函数的极值。",
          "answer": "极大值为 $2$，极小值为 $-2$。",
